# ---- services (names only; real values come from your secret store)
NODE_ENV=development
SERVICE_ROLE=commerce
PORT=4000
LOG_LEVEL=info
# Login role that is a member of jw_commerce_api (NOT a superuser). Experience API: jw_experience_login. Workers: jw_worker_login.
DATABASE_URL=postgres://jw_api_login:CHANGE_ME@127.0.0.1:54422/jimmywax_dev
DB_POOL_MAX=10
REDIS_CACHE_URL=redis://127.0.0.1:56380
# ---- own identity service (no external provider)
# Dev: leave AUTH_SIGNING_PRIVATE_KEY unset to get an ephemeral key. Production REQUIRES both of these:
AUTH_SIGNING_PRIVATE_KEY=       # openssl genpkey -algorithm ed25519  (PEM; \n escapes allowed)
AUTH_TOTP_ENC_KEY=              # openssl rand -base64 32
AUTH_ISSUER=jimmywax
AUTH_AUDIENCE=jimmywax-api
# ---- email (unset SMTP_HOST = emails are logged, never sent)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=JIMMY WAX <no-reply@localhost>
STORAGE_DIR=./.data/storage
TRUST_PROXY_HOPS=0
CORS_ORIGINS=
# ---- payments
PAYMENT_PROVIDER=none
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Website origin the hosted checkout returns to (https, no path); required in production with online payments
STOREFRONT_ORIGIN=
# Optional: public https origin of this API, and the app's deep link after payment (e.g. jimmywax://payment)
PUBLIC_API_ORIGIN=
APP_RETURN_URL=
ADMIN_REQUIRE_MFA=true
FEATURE_CHECKOUT=false
FEATURE_COD=false
FEATURE_ONLINE_PAYMENTS=false
# ---- admin console (Next.js)
ADMIN_SESSION_SECRET=           # >= 32 random characters
COMMERCE_API_URL=http://127.0.0.1:4000
# ---- shipping provider (Shiprocket). none = manual courier entry. NEVER set fake in production.
SHIPPING_PROVIDER=none
SHIPROCKET_EMAIL=          # API user created in Shiprocket (not your login)
SHIPROCKET_PASSWORD=
SHIPROCKET_API_TOKEN=     # alternative to API-user email/password; expires and needs replacement
SHIPROCKET_WEBHOOK_TOKEN=  # sent by Shiprocket as x-api-key to /v1/webhooks/shiprocket
SHIPROCKET_BASE_URL=       # optional override; default is the public API host
# ---- optional
OLA_MAPS_API_KEY=          # only used to report maps as configured in the integrations page
# Real phone delivery. Console is development-only; production uses an approved provider sender/template.
SMS_PROVIDER=none
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_FROM=
SMS_OTP_TEMPLATE={{code}} is your JIMMY WAX verification code. It is valid for 5 minutes. Do not share it.
